# ==============================================================================
# Peblo TV Mini — Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=True
PORT=8000

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Async URL for FastAPI & asyncpg runtime
DATABASE_URL=postgresql+asyncpg://peblo_user:peblo_password@db:5432/peblo_db
# Sync URL for Alembic migrations or sync tooling
SYNC_DATABASE_URL=postgresql+psycopg2://peblo_user:peblo_password@db:5432/peblo_db

# Local host fallback for standalone execution:
# DATABASE_URL=postgresql+asyncpg://peblo_user:peblo_password@localhost:5432/peblo_db

# ------------------------------------------------------------------------------
# Storage Abstraction Configuration
# ------------------------------------------------------------------------------
# Options: 'local' (local disk storage with atomic temp swap) or 'r2' (Cloudflare R2)
STORAGE_BACKEND=local

# Local Storage Directory Paths
UPLOAD_DIR=/app/storage/uploads
PUBLISHED_DIR=/app/storage/published

# Cloudflare R2 Credentials (used when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=peblo-tv-assets
R2_PUBLIC_URL_PREFIX=https://assets.peblo.tv

# ------------------------------------------------------------------------------
# Security & RBAC Auth
# ------------------------------------------------------------------------------
SECRET_KEY=peblo-tv-mini-super-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# ------------------------------------------------------------------------------
# Secret Management in Production:
# In production, never commit plaintext credentials to Git. Secrets should be injected
# at container runtime via AWS Secrets Manager, HashiCorp Vault, or GitHub Actions
# Secrets into the Kubernetes / ECS task definition environment.
# ==============================================================================
